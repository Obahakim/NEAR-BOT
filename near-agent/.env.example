# NEAR (testnet recommended)
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Optional: only for non-interactive setup
# NEAR_ACCOUNT_ID=your-account.testnet
# NEAR_PRIVATE_KEY=ed25519:...

# Approximate USD for ASGUARD amount_usd field (optional)
# NEAR_USD_HINT=0.05

# ASGUARD pre-sign gate (fail closed when enabled)
ASGUARD_ENABLED=true
ASGUARD_URL=http://localhost:8080
# Must match a credential with role "runtime" in ASGUARD_API_CREDENTIALS
ASGUARD_RUNTIME_TOKEN=REPLACE_WITH_RUNTIME_TOKEN
ASGUARD_AGENT_ID=near-bot
ASGUARD_AGENT_NAME=NEAR-BOT
