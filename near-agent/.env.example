# NEAR (testnet recommended)
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# wrap.testnet for testnet wNEAR deposits
NEAR_WRAP_ACCOUNT=wrap.testnet

# ASGUARD — use the RUNTIME credential token (role: runtime), not the dashboard token
ASGUARD_ENABLED=true
ASGUARD_URL=http://localhost:8080
ASGUARD_MCP_URL=http://localhost:8080/mcp
# auto | rest | mcp
ASGUARD_TRANSPORT=auto
ASGUARD_RUNTIME_TOKEN=REPLACE_WITH_RUNTIME_TOKEN_FROM_ASGUARD_API_CREDENTIALS
ASGUARD_AGENT_ID=near-bot
ASGUARD_AGENT_NAME=NEAR-BOT

# Autonomous loop
AUTO_INTERVAL_MIN_MS=5000
AUTO_INTERVAL_MAX_MS=30000
AUTO_AMOUNT_MIN=0.01
AUTO_AMOUNT_MAX=0.1
# Comma-separated receivers; empty = self-transfer only
AUTO_RECEIVERS=
AUTO_TRANSFER_WEIGHT=0.7
AUTO_MIN_BALANCE=0.05
# continue | stop after ASGUARD reject / HITL deny
AUTO_ON_HITL_REJECT=continue
AUTO_MAX_CONSECUTIVE_FAILURES=10
